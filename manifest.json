{
  "manifest_version": 3,
  "name": "GameDev.ru Blacklist",
  "version": "1.0.0",
  "description": "Скрывает темы и посты пользователей из чёрного списка на форуме gamedev.ru.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GameDev.ru Blacklist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://gamedev.ru/*", "*://www.gamedev.ru/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
